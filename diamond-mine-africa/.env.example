# Keep demo mode enabled. The application does not support real-money transactions.
VITE_DEMO_MODE="true"

# Supabase browser-safe configuration. The publishable key may be used in frontend code;
# NEVER put an sb_secret key, service_role key, or database password in VITE_ variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
